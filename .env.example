# =============================================================================
#  OrganizAPP — Variables de Entorno (Template para .env)
# =============================================================================
#  1. Copia ESTE archivo y renombra la copia como ".env"
#  2. Reemplaza YOUR_* con tus valores reales.
#  3. NO COMMITEES el archivo ".env" real (ya está en .gitignore por ahora).
# =============================================================================

# ---------------------------------------------------------------------------
#  Modo de ejecucion
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
#  Backend: Proveedor de Base de Datos (Factory de Repositorios)
#  Opciones: mongodb | supabase | postgres
# ---------------------------------------------------------------------------
DB_PROVIDER=mongodb

# ---------------------------------------------------------------------------
#  MongoDB (proveedor "mongodb")
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/organizapp

# ---------------------------------------------------------------------------
#  SUPABASE — usados por BOTH:
#    - Backend (api/repositories/supabase) con SUPABASE_SERVICE_ROLE_KEY
#    - Frontend Directo (src/services/supabaseBackend.ts) con SUPABASE_ANON_KEY
#  Obten estas credenciales en:
#  https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY__REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY__REPLACE_ME__KEEP_SECRET

# ---------------------------------------------------------------------------
#  Variables VITE — usadas por el frontend cuando se corre con Vite.
#  (Para uso directo desde Supabase Frontend Directo = dataProvider=supabase)
#  El start_app.bat las setea automaticamente al arrancar en modo Directo.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY__REPLACE_ME
